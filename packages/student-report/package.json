{
  "name": "@wispace/student-report",
  "version": "0.0.1",
  "description": "Shared student-report package with a port-driven core and an explicit NestJS platform adapter",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --maxWorkers=50%"
  },
  "dependencies": {
    "@wispace/bot-common": "*",
    "@wispace/chat-metering": "*",
    "@wispace/contracts": "*",
    "@wispace/llm-agent": "*",
    "@wispace/wispace-client": "*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "openai": "^6.42.0",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
