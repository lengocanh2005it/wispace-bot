{
  "name": "@wispace/learner-profile",
  "version": "0.0.1",
  "description": "Compact per-learner facts (band target, exam date) sourced only from server-derived tool results, injected into chat prompts with freshness rules",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "test": "jest --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/typeorm": "^12.0.1",
    "@wispace/bot-common": "*",
    "@wispace/database": "*",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "@swc/jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|@nestjs|necord)/)"
    ]
  }
}
