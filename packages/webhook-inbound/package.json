{
  "name": "@wispace/webhook-inbound",
  "version": "0.0.1",
  "description": "Durable webhook inbound inbox for WISPACE bots — ingest, retry cron, retention cleanup",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "test": "jest --forceExit --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@wispace/bot-common": "*",
    "@wispace/contracts": "*",
    "@wispace/database": "*",
    "@wispace/scheduler-core": "*",
    "date-fns": "^4.4.0",
    "prom-client": "^15.1.3",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.12"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "@swc/jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|@nestjs|necord)/)"
    ]
  }
}
