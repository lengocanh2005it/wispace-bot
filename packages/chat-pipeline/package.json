{
  "name": "@wispace/chat-pipeline",
  "version": "0.0.1",
  "description": "Framework-agnostic chat flush pipeline (reserve → history → agent → send → complete) shared across WISPACE bots",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.build.json --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "jest --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wispace/chat-history": "*",
    "@wispace/contracts": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "@swc/jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|@nestjs|necord)/)"
    ]
  }
}
