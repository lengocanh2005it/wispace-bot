{
  "name": "@wispace/chat-metering",
  "version": "0.0.1",
  "description": "Shared chat-metering package with framework-agnostic policy cores and explicit NestJS/TypeORM adapters",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts",
      "require": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.build.json --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "jest --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@nestjs/typeorm": "^12.0.1",
    "@wispace/bot-common": "*",
    "@wispace/contracts": "*",
    "@wispace/date-utils": "*",
    "@wispace/llm-agent": "*",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.12"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "@swc/jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|@nestjs|necord)/)"
    ]
  }
}
