{
  "name": "@wispace/chat-metering",
  "version": "0.0.1",
  "description": "Framework-agnostic chat quota/rate-limit + LLM usage/safety event tracking shared across WISPACE bots (Messenger, Discord, Zalo)",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --maxWorkers=50%"
  },
  "dependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@wispace/bot-common": "*",
    "@wispace/contracts": "*",
    "@wispace/date-utils": "*",
    "@wispace/llm-agent": "*",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.12"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
