{
  "name": "@wispace/bot-common",
  "version": "0.0.1",
  "description": "Shared NestJS infrastructure for WISPACE bots: ops API guard, advisory locks",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "test": "jest --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "@wispace/contracts": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "@swc/jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|@nestjs|necord)/)"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./guard": {
      "import": "./dist/guard/index.js",
      "require": "./dist/guard/index.js",
      "types": "./dist/guard/index.d.ts"
    },
    "./locks": {
      "import": "./dist/locks/index.js",
      "require": "./dist/locks/index.js",
      "types": "./dist/locks/index.d.ts"
    },
    "./cron": {
      "import": "./dist/cron/index.js",
      "require": "./dist/cron/index.js",
      "types": "./dist/cron/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./logging": {
      "import": "./dist/logging/index.js",
      "require": "./dist/logging/index.js",
      "types": "./dist/logging/index.d.ts"
    },
    "./messages": {
      "import": "./dist/messages/index.js",
      "require": "./dist/messages/index.js",
      "types": "./dist/messages/index.d.ts"
    },
    "./masking": {
      "import": "./dist/masking/index.js",
      "require": "./dist/masking/index.js",
      "types": "./dist/masking/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./redis": {
      "import": "./dist/redis/index.js",
      "require": "./dist/redis/index.js",
      "types": "./dist/redis/index.d.ts"
    },
    "./health": {
      "import": "./dist/health/index.js",
      "require": "./dist/health/index.js",
      "types": "./dist/health/index.d.ts"
    },
    "./secrets": {
      "import": "./dist/secrets/index.js",
      "require": "./dist/secrets/index.js",
      "types": "./dist/secrets/index.d.ts"
    },
    "./bootstrap": {
      "import": "./dist/bootstrap/index.js",
      "require": "./dist/bootstrap/index.js",
      "types": "./dist/bootstrap/index.d.ts"
    }
  }
}
