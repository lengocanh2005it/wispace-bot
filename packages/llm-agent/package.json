{
  "name": "@wispace/llm-agent",
  "version": "0.0.1",
  "description": "Shared LLM package with a framework-agnostic orchestration core and explicit provider/runtime adapters",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts",
      "require": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    },
    "./provider": {
      "import": "./dist/provider/index.js",
      "types": "./dist/provider/index.d.ts",
      "require": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    },
    "./tools": {
      "import": "./dist/agent.tools.js",
      "types": "./dist/agent.tools.d.ts",
      "require": "./dist/agent.tools.js",
      "default": "./dist/agent.tools.js"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./execution": {
      "import": "./dist/execution/index.js",
      "types": "./dist/execution/index.d.ts",
      "require": "./dist/execution/index.js",
      "default": "./dist/execution/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.build.json --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "jest --maxWorkers=50%",
    "eval:chat": "jest src/eval --runInBand",
    "eval:rehash": "node dist/eval/rehash-fixtures.main.js",
    "eval:rehash:check": "node dist/eval/rehash-fixtures.main.js --check",
    "eval:guardrail": "node dist/eval/guardrail-battery.main.js",
    "classifier:eval": "node dist/classifier/classifier-eval.main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@wispace/bot-common": "*",
    "@wispace/chat-history": "*",
    "ioredis": "^6.0.0",
    "openai": "^7.15.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|@nestjs|necord)/)"
    ]
  }
}
