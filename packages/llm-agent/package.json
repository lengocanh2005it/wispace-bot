{
  "name": "@wispace/llm-agent",
  "version": "0.0.1",
  "description": "Framework-agnostic LLM function-calling orchestration shared across WISPACE bots (Messenger, Discord, Zalo)",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./provider": {
      "import": "./dist/provider/index.js",
      "types": "./dist/provider/index.d.ts",
      "require": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    },
    "./tools": {
      "import": "./dist/agent.tools.js",
      "types": "./dist/agent.tools.d.ts",
      "require": "./dist/agent.tools.js",
      "default": "./dist/agent.tools.js"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./execution": {
      "import": "./dist/execution/index.js",
      "types": "./dist/execution/index.d.ts",
      "require": "./dist/execution/index.js",
      "default": "./dist/execution/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --maxWorkers=50%",
    "eval:chat": "jest src/eval --runInBand",
    "eval:guardrail": "node dist/eval/guardrail-battery.main.js",
    "classifier:eval": "node dist/classifier/classifier-eval.main.js"
  },
  "dependencies": {
    "@wispace/bot-common": "*",
    "@wispace/chat-history": "*",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "testEnvironment": "node"
  }
}
