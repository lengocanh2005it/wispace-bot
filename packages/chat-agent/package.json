{
  "name": "@wispace/chat-agent",
  "version": "0.0.1",
  "description": "Platform-parameterized chat agent services (LLM agent + tools, chat queue, chat history) shared across WISPACE bots (Discord, Zalo)",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --maxWorkers=50%"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@wispace/bot-common": "*",
    "@wispace/chat-history": "*",
    "@wispace/chat-metering": "*",
    "@wispace/chat-pipeline": "*",
    "@wispace/chat-queue-core": "*",
    "@wispace/contracts": "*",
    "@wispace/llm-agent": "*",
    "@wispace/reschedule-confirm": "*",
    "@wispace/scheduler-core": "*",
    "@wispace/wispace-client": "*",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.2.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
