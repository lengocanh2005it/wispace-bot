{
  "name": "@wispace/reschedule-confirm",
  "version": "0.0.1",
  "description": "Generic reschedule confirmation service for WISPACE bots",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts",
      "require": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "test": "jest --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@wispace/bot-common": "*",
    "@wispace/bot-metrics": "*",
    "@wispace/contracts": "*",
    "@wispace/database": "*",
    "@wispace/wispace-client": "*",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "@swc/jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|@nestjs|necord)/)"
    ]
  }
}
