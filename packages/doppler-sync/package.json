{
  "name": "@wispace/doppler-sync",
  "version": "0.0.1",
  "description": "Platform-agnostic Doppler env sync helper for WISPACE bots",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "test": "jest --passWithNoTests --maxWorkers=50%"
  },
  "dependencies": {
    "@wispace/bot-common": "*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
