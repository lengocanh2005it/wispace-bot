{
  "name": "wispace-bots",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages",
    "knip": "knip",
    "knip:deps": "knip --include dependencies,unlisted,unresolved --no-config-hints",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval:rehash": "npm run eval:rehash --workspace=@wispace/llm-agent --",
    "eval:rehash:check": "npm run eval:rehash:check --workspace=@wispace/llm-agent",
    "test:affected": "turbo run test --affected",
    "database:bootstrap-smoke": "node scripts/database-bootstrap-smoke.mjs",
    "database:query-returning-shape-smoke": "node scripts/query-returning-shape-smoke.mjs",
    "database:privacy-smoke": "node scripts/database-privacy-smoke.mjs",
    "database:privacy-erasure-drill": "node scripts/privacy-erasure-drill.mjs",
    "database:persistence-semantics-smoke": "node scripts/database-persistence-semantics-smoke.mjs",
    "study-reminder:delivery-smoke": "node scripts/study-reminder-delivery-smoke.mjs",
    "database:migration-compatibility": "node scripts/database-bootstrap-smoke.mjs --migrations",
    "database:entity-discovery:test": "node --test scripts/database-entity-discovery.test.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "architecture:test": "node --test scripts/check-architecture.test.mjs",
    "redis-usage:check": "node scripts/check-redis-usage.mjs",
    "redis-usage:test": "node --test scripts/check-redis-usage.test.mjs",
    "metric-registry:check": "node .github/scripts/check-metric-registration.js",
    "metric-registry:test": "node --test .github/scripts/tests/check-metric-registration.test.mjs",
    "workspace-deps:check": "node scripts/check-workspace-deps.mjs",
    "workspace-deps:test": "node --test scripts/check-workspace-deps.test.mjs",
    "manifest-deps:check": "node scripts/check-manifest-deps.mjs",
    "manifest-deps:test": "node --test scripts/check-manifest-deps.test.mjs",
    "runtime-image:test": "node --test deploy/runtime-image-check.test.mjs",
    "prove-checks:test": "node --test .claude/skills/prove-checks/scripts/verify-mutation.test.mjs",
    "file-size:check": "node scripts/check-file-size.mjs",
    "file-size:report": "node scripts/check-file-size.mjs --report",
    "file-size:test": "node --test scripts/check-file-size.test.mjs",
    "verify:definition:test": "node --test scripts/verify.test.mjs",
    "verify:affected": "node scripts/verify.mjs --affected",
    "verify": "node scripts/verify.mjs",
    "entrypoint-consumers:check": "node scripts/check-export-subpath-consumers.mjs",
    "entrypoint-consumers:test": "node --test scripts/check-export-subpath-consumers.test.mjs"
  },
  "devDependencies": {
    "@nestjs/config": "^12.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/opossum": "^8.1.9",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "knip": "6.38.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.3.0",
    "typeorm": "^1.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "optionalDependencies": {
    "@swc/core-linux-x64-gnu": "1.15.46",
    "@swc/core-linux-x64-musl": "1.15.46"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt",
      "oxlint --fix --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@nestjs/throttler": "^6.5.0",
    "opossum": "^10.0.0"
  },
  "overrides": {
    "multer": "2.3.0",
    "@nestjs/throttler": {
      "@nestjs/common": "^12.1.1",
      "@nestjs/core": "^12.1.1"
    },
    "necord": {
      "@nestjs/common": "^12.1.1",
      "@nestjs/core": "^12.1.1"
    },
    "ioredis": "^6.0.0"
  }
}
