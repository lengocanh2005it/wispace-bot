{
  "name": "wispace-bots",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "verify:affected": "turbo run format:check lint typecheck test build --affected",
    "verify": "turbo run format:check lint typecheck test build"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/opossum": "^8.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "optionalDependencies": {
    "@swc/core-linux-x64-gnu": "1.15.46",
    "@swc/core-linux-x64-musl": "1.15.46"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "dependencies": {
    "@nestjs/throttler": "^6.5.0",
    "opossum": "^10.0.0"
  }
}
