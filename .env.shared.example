# Variables SHARED across all bots (messenger-bot, discord-bot, zalo-bot later).
# Copy to `.env.shared` at root (do not commit) — each app reads this file
# as fallback via ConfigModule.forRoot({ envFilePath: ['.env', '../../.env.shared'] }).
# The app's own `.env` always overrides if the same key exists.
#
# Platform-SPECIFIC variables (token, client id/secret, verify-token URL, etc.)
# remain in each app's .env.example — DO NOT put them here.
#
# Production (Doppler): see docs/doppler-secrets.md — instead of manually copying
# these values into each Doppler project, use Doppler secret references from
# the shared `wispace-shared` project.

# WISPACE API — server-to-server auth
WISPACE_INTERNAL_KEY=replace-with-wispace-internal-key
# Account-link token verify — same URL for all 3 bots, payload { token, value, platform }
WISPACE_API_VERIFY_TOKEN_URL=https://testbackend.aihubproduction.com/api/User/verify-token-url
WISPACE_API_MAX_RETRIES=3
WISPACE_API_RETRY_BASE_DELAY_MS=500
WISPACE_API_USER_GOALS_URL=https://testbackend.aihubproduction.com/api/User/goals
WISPACE_API_TASK_SCORE_URL=https://testbackend.aihubproduction.com/api/TaskScoreAverage
WISPACE_API_USER_CALENDAR_URL=https://testbackend.aihubproduction.com/api/UserCalendar
WISPACE_API_PRECREATE_EXERCISE_URL=https://testbackend.aihubproduction.com/api/roadmap/precreate-exercise
WISPACE_API_PRECREATE_EXERCISE_TIMEOUT_MS=30000
# Fail-closed upstream URL policy: every WISPACE URL must be HTTPS (dev
# exception: http://localhost when NODE_ENV != production), must not contain
# credentials/fragments, and must not target localhost/private networks in
# production. Optional allowlist — when set, only these hosts are accepted.
# WISPACE_ALLOWED_HOSTS=testbackend.aihubproduction.com,backend.aihubproduction.com

# Study reminders — timezone/horizon/min-lead shared by all bots reading/writing Wispace schedule
STUDY_REMINDER_TIMEZONE=Asia/Ho_Chi_Minh
STUDY_REMINDER_SYNC_HORIZON_HOURS=336
STUDY_REMINDER_MIN_LEAD_MINUTES=1

# OpenAI (chat agent, reports)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.4
OPENAI_MAX_TOOL_ROUNDS=6
OPENAI_MAX_CONTEXT_CHARS=24000
OPENAI_MAX_OUTPUT_TOKENS=1024

# Multi-LLM provider failover — CSV order, empty = no failover (single provider only)
# LLM_PROVIDER_FAILOVER_ORDER=openai,openrouter,minimax
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-Text-01
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# Failover tuning (ms) — override if needed
# LLM_FAILOVER_COOLDOWN_LONG_MS=600000
# LLM_FAILOVER_COOLDOWN_SHORT_MS=5000
# LLM_FAILOVER_QUICK_RETRY_DELAY_MS=150

# LLM usage/cost tracking (@wispace/chat-metering)
LLM_USAGE_ENABLED=true
LLM_USAGE_TIMEZONE=Asia/Ho_Chi_Minh
LLM_COST_USD_PER_1M_INPUT_TOKENS_GPT_5_4=2.50
LLM_COST_USD_PER_1M_OUTPUT_TOKENS_GPT_5_4=15.00
# Optional — cached input price (OpenAI prompt caching). If left blank, defaults to 50% of input price.
# LLM_COST_USD_PER_1M_CACHED_INPUT_TOKENS_GPT_5_4=1.25
CHAT_USAGE_TIMEZONE=Asia/Ho_Chi_Minh

# HTTP throttling — Redis-backed and shared across pods when REDIS_ENABLED=true
THROTTLE_DEFAULT_LIMIT=20
THROTTLE_DEFAULT_TTL_MS=60000
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_RATE_LIMIT_TTL_MS=60000

# PostgreSQL — shared DB for all bots (Phase 2: keyed by (platform, external_user_id))
# IMPORTANT: Do NOT use production credentials here. Use Doppler for prod.
# TLS is enforced for every host that is not localhost/a private IPv4 address —
# startup and migration commands fail when DB_SSL=false points at a public host.
# DB_ALLOW_INSECURE_HOSTS is the ONLY plaintext exception: comma-separated
# hostnames that cannot be IP-classified (e.g. Docker-internal `postgres`).
#
# Connection pooling: In production, route through PgBouncer (session mode)
# to share DB connections across all bot containers. Bot containers on the
# monitoring network use the separate host/port values below; do not put a
# host:port pair in DB_HOST. See deploy/docker-compose.pgbouncer.yml.
DB_HOST=your-db-host
DB_PORT=5434
DB_NAME=ai_chat_bot_db
DB_USER=your-db-user
DB_PASSWORD=your_password_here  # CHANGE THIS — never use this placeholder in prod
DB_SSL=false
DB_SSL_CA=
# DB_ALLOW_INSECURE_HOSTS=postgres,db.internal
# Production PgBouncer example (when the bot is on the monitoring network):
# DB_HOST=pgbouncer
# DB_PORT=5432
# DB_ALLOW_INSECURE_HOSTS=pgbouncer
DB_LOGGING=false
