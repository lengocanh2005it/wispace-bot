{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!src/**/__mocks__/**",
        "!**/jest.config.*"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["src/**", "package.json"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["src/**", "package.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/jest.config.*"],
      "outputs": ["**/*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "jest.config.*"],
      "outputs": []
    },
    "verify": {
      "dependsOn": ["typecheck", "test", "build"],
      "cache": false
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
