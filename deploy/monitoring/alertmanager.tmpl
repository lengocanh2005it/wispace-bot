# Telegram receiver. ${TELEGRAM_BOT_TOKEN} / ${TELEGRAM_CHAT_ID} are replaced
# from the compose .env by alertmanager-entrypoint.sh (Alertmanager has no
# built-in env substitution).
route:
  receiver: telegram
  group_by: [alertname, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "${TELEGRAM_BOT_TOKEN}"
        # unquoted on purpose — chat_id is an int64 in Alertmanager
        chat_id: ${TELEGRAM_CHAT_ID}
        parse_mode: HTML
        send_resolved: true
