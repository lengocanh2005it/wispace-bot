# Receiver credentials are injected by alertmanager-entrypoint.sh (#536/#683).
# Alertmanager has no built-in environment substitution.
# Routing (#683): severity=critical fans out to three independent channels —
# Discord @here (primary), Pushover emergency priority (retry 5m until ack,
# stops after 1h — the escalation semantics), Telegram (existing leg).
# Everything else goes to the no-ping Discord warning channel; the root
# receiver is that same low-urgency fallback so an unlabeled alert stays
# visible instead of being dropped silently.
route:
  receiver: discord-warning
  group_by: [alertname, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Deadman intercept (#515) — must stay FIRST and must not `continue`: the
    # Watchdog alert fires forever and only feeds the external heartbeat.
    # Routing it into the critical fan-out would ping Discord/Pushover/Telegram
    # every 2 minutes. send_resolved is false on the receiver: a resolved
    # notification when Prometheus dies must not fake-alive the heartbeat.
    - matchers: [ 'alertname="Watchdog"' ]
      receiver: healthchecks-heartbeat
      group_wait: 0s
      group_interval: 2m
      repeat_interval: 2m
    # Flat fan-out: `continue: true` lets each sibling also dispatch, so one
    # critical alert reaches all three independent legs. A route whose
    # children match would NOT use its own receiver — hence siblings, not
    # nesting.
    - matchers: [ 'severity="critical"' ]
      receiver: discord-critical
      repeat_interval: 30m
      continue: true
    - matchers: [ 'severity="critical"' ]
      receiver: pushover
      repeat_interval: 30m
      continue: true
    - matchers: [ 'severity="critical"' ]
      receiver: telegram
      repeat_interval: 30m
    - matchers: [ 'severity="warning"' ]
      receiver: discord-warning

receivers:
  - name: healthchecks-heartbeat
    # #515 deadman: ping the external heartbeat service. Missing this ping is
    # the only signal the outside world gets when this whole host dies.
    webhook_configs:
      - url: "${HEALTHCHECKS_PING_URL}"
        send_resolved: false
  - name: discord-critical
    discord_configs:
      - webhook_url: "${DISCORD_ALERT_WEBHOOK_CRITICAL_URL}"
        send_resolved: true
        # AM 0.27 Discord receiver posts embeds only (no `content` field), so
        # a webhook payload cannot hard-ping @here — Pushover is the true
        # interrupt leg for critical. The @here marker still renders visually
        # in the embed text; enable mention permissions on the webhook so
        # clients that do render it also highlight.
        title: '{{ if eq .Status "firing" }}[FIRING]{{ else }}[RESOLVED]{{ end }} {{ .CommonLabels.alertname }}'
        message: '@here {{ template "discord.default.message" . }}'
  - name: discord-warning
    discord_configs:
      - webhook_url: "${DISCORD_ALERT_WEBHOOK_WARNING_URL}"
        send_resolved: true
        title: '{{ if eq .Status "firing" }}[FIRING]{{ else }}[RESOLVED]{{ end }} {{ .CommonLabels.alertname }}'
        message: '{{ template "discord.default.message" . }}'
  - name: pushover
    pushover_configs:
      - user_key: "${PUSHOVER_USER_KEY}"
        token: "${PUSHOVER_API_TOKEN}"
        send_resolved: true
        # Emergency priority (2) while firing = repeat every `retry` until
        # acknowledged, gives up after `expire` (the escalation window).
        # Resolved alerts drop to normal priority (0). This mirrors the AM
        # 0.27 default, spelled out so the escalation contract is visible.
        priority: '{{ if eq .Status "firing" }}2{{ else }}0{{ end }}'
        retry: 5m
        expire: 1h
  - name: telegram
    telegram_configs:
      - bot_token: "${TELEGRAM_BOT_TOKEN}"
        # unquoted on purpose — chat_id is an int64 in Alertmanager
        chat_id: ${TELEGRAM_CHAT_ID}
        parse_mode: HTML
        send_resolved: true
