# Telegram receiver. __TELEGRAM_BOT_TOKEN__ / __TELEGRAM_CHAT_ID__ are
# replaced from the compose .env by alertmanager-entrypoint.sh (Alertmanager
# has no built-in env substitution).
route:
  receiver: telegram
  group_by: [alertname, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "__TELEGRAM_BOT_TOKEN__"
        # unquoted on purpose — chat_id is an int64 in Alertmanager
        chat_id: __TELEGRAM_CHAT_ID__
        parse_mode: HTML
        send_resolved: true
