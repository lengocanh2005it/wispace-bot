global:
  scrape_interval: 15s
  evaluation_interval: 15s

# All 3 bots bind to 127.0.0.1 on the host, so scrape them by container name
# on their own Docker networks (Prometheus is attached to all of them).
# Metrics endpoints sit behind InternalApiKeyGuard, which accepts
# `Authorization: Bearer <INTERNAL_API_KEY>` — the key is injected from the
# monitoring .env (Prometheus expands ${VAR} at startup).
scrape_configs:
  - job_name: messenger_bot
    static_configs:
      - targets:
          - messenger-bot:5007
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: __INTERNAL_API_KEY_MESSENGER__

  - job_name: discord_bot
    static_configs:
      - targets:
          - discord-bot:3001
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: __INTERNAL_API_KEY_DISCORD__

  - job_name: zalo_bot
    static_configs:
      - targets:
          - zalo-bot:3002
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: __INTERNAL_API_KEY_ZALO__

rule_files:
  - /etc/prometheus/alert.rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093
