global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Blue-green deploy starts containers via bare `docker run` (not compose).
# Each active container joins the shared monitoring network with a stable
# `<app>-metrics` alias; the deploy script moves that alias at cutover (#278).
# Metrics endpoints sit behind InternalApiKeyGuard, which accepts
# `Authorization: Bearer <INTERNAL_API_KEY>` — the key is injected from the
# monitoring .env by prometheus-entrypoint.sh.
scrape_configs:
  - job_name: messenger_bot
    static_configs:
      - targets:
          - messenger-bot-metrics:5007
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: ${INTERNAL_API_KEY_MESSENGER}

  - job_name: discord_bot
    static_configs:
      - targets:
          - discord-bot-metrics:3001
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: ${INTERNAL_API_KEY_DISCORD}

  - job_name: zalo_bot
    static_configs:
      - targets:
          - zalo-bot-metrics:3002
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: ${INTERNAL_API_KEY_ZALO}

rule_files:
  - /etc/prometheus/alert.rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093
