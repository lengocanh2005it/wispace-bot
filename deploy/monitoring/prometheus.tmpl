global:
  scrape_interval: 15s
  evaluation_interval: 15s

# All 3 bots bind to 127.0.0.1:<port> on the host.
# Blue-green deploy starts containers via bare `docker run` (not compose),
# so container names are not on the compose networks. Scrape by host IP
# instead — works regardless of container networking (#179).
# Metrics endpoints sit behind InternalApiKeyGuard, which accepts
# `Authorization: Bearer <INTERNAL_API_KEY>` — the key is injected from the
# monitoring .env (Prometheus expands ${VAR} at startup).
scrape_configs:
  - job_name: messenger_bot
    static_configs:
      - targets:
          - 127.0.0.1:5007
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: __INTERNAL_API_KEY_MESSENGER__

  - job_name: discord_bot
    static_configs:
      - targets:
          - 127.0.0.1:3001
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: __INTERNAL_API_KEY_DISCORD__

  - job_name: zalo_bot
    static_configs:
      - targets:
          - 127.0.0.1:3002
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: __INTERNAL_API_KEY_ZALO__

rule_files:
  - /etc/prometheus/alert.rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093
