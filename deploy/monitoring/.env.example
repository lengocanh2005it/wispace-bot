# Copy to .env in this directory. GRAFANA_PASSWORD is required. The bot
# alerts need a real Telegram bot token + chat id; the INTERNAL_API_KEY_*
# values come from each bot's .env (metrics endpoints require the header).
# #683: the Discord webhook URLs and Pushover keys are the severity-routed
# channels; all four are fail-closed (Alertmanager refuses to start without
# them). Discord setup: two channels (#alerts-critical, #alerts-warnings),
# one Integration > Webhook per channel. Pushover: one user account + an
# application token; emergency priority repeats every 5m until acknowledged
# and gives up after 1h.
GRAFANA_PASSWORD=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_ALERT_WEBHOOK_CRITICAL_URL=
DISCORD_ALERT_WEBHOOK_WARNING_URL=
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
INTERNAL_API_KEY_MESSENGER=
INTERNAL_API_KEY_DISCORD=
INTERNAL_API_KEY_ZALO=
