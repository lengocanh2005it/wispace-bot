# syntax=docker/dockerfile:1
# Build context: repo root (needs access to shared packages)
# docker build -f deploy/Dockerfile.bot --build-arg APP_NAME=messenger-bot .
# ARG APP_NAME must be redeclared in each stage that uses it.

ARG APP_NAME=messenger-bot
ARG APP_PORT=5007
ARG WITH_DOPPLER=true

FROM node:22-alpine AS build
WORKDIR /app
ARG APP_NAME

COPY package.json package-lock.json ./
COPY apps/$APP_NAME/package.json apps/$APP_NAME/package.json
# Package manifests only (keep structure for npm workspace resolution);
# exclude source so npm ci cache survives package code changes.
COPY --exclude='*/src' --exclude='*/dist' --exclude='*/coverage' --exclude='*/node_modules' packages packages
RUN --mount=type=cache,target=/root/.npm HUSKY=0 npm ci

# Source layer: exclude CI/deploy/docs — keeps cache when only those change.
COPY --exclude=.git --exclude=node_modules --exclude=.github --exclude=deploy --exclude=docs --exclude='*.md' --exclude='.env*' --exclude='docker-compose*' . .
RUN npx turbo run build

# Flatten: replace workspace symlinks with actual built packages
RUN for pkg in packages/*/; do \
      name=$(node -p "require('./${pkg}package.json').name" 2>/dev/null || true); \
      if [ -n "$name" ] && [ -d "node_modules/$name" ]; then \
        rm -rf "node_modules/$name"; \
        cp -r "$pkg" "node_modules/$name"; \
      fi; \
    done

FROM node:22-alpine AS production
WORKDIR /app

# Global ARGs are out of scope after FROM — redeclare per stage that uses them.
ARG APP_NAME
ARG APP_PORT

ENV NODE_ENV=production
ENV APP_NAME=$APP_NAME

ARG WITH_DOPPLER
RUN apk add --no-cache curl bash \
  && if [ "$WITH_DOPPLER" = "true" ]; then \
       apk add --no-cache docker-cli docker-cli-compose gnupg \
       && curl -LsSf https://cli.doppler.com/install.sh | sh -s -- --install-path /usr/local/bin; \
     fi \
  && addgroup -g 1001 -S app \
  && adduser -S app -u 1001 -G app

COPY --from=build --chown=app:app /app/apps/$APP_NAME/dist ./apps/$APP_NAME/dist
COPY --from=build --chown=app:app /app/apps/$APP_NAME/node_modules ./apps/$APP_NAME/node_modules
COPY --from=build --chown=app:app /app/node_modules ./node_modules

USER app

EXPOSE $APP_PORT

CMD ["sh", "-c", "exec node apps/$APP_NAME/dist/main.js"]
