# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# Build context: repo root (needs access to shared packages)
# docker build -f deploy/Dockerfile.bot --build-arg APP_NAME=messenger-bot .
# ARG APP_NAME must be redeclared in each stage that uses it.

ARG APP_NAME=messenger-bot
# Fixed internal listener port; vps-deploy.sh alternates only the host port.
ARG APP_PORT=5007

FROM node:26.8.1-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS pruner
WORKDIR /src
ARG APP_NAME

# Install the lockfile-resolved dependency tree before copying source so
# source changes do not invalidate this dependency layer. The bind mount
# contributes workspace manifests without persisting the full source tree.
RUN --mount=type=bind,source=.,target=/context,ro \
    --mount=type=cache,target=/root/.npm \
    set -eu; \
    cp /context/package.json /context/package-lock.json /src/; \
    find /context/apps /context/packages -name package.json -print | while read -r manifest; do \
      relative="${manifest#/context/}"; \
      mkdir -p "/src/$(dirname "$relative")"; \
      cp "$manifest" "/src/$relative"; \
    done; \
    HUSKY=0 npm ci
COPY . .
RUN npx --no-install turbo prune @wispace/${APP_NAME} --docker --out-dir /tmp/pruned

FROM node:26.8.1-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS build
WORKDIR /app
ARG APP_NAME

COPY --from=pruner /tmp/pruned/json/ ./
COPY --from=pruner /tmp/pruned/package-lock.json ./package-lock.json
COPY --from=pruner /src/tsconfig.base.json ./tsconfig.base.json
COPY --from=pruner /src/tsconfig.base-loose.json ./tsconfig.base-loose.json
RUN --mount=type=cache,target=/root/.npm HUSKY=0 npm ci

COPY --from=pruner /tmp/pruned/full/ ./
RUN npx --no-install turbo run build --filter=@wispace/${APP_NAME}...

# Install the runtime dependency graph in a clean workspace after the build.
FROM node:26.8.1-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS production-deps
WORKDIR /app
ARG APP_NAME

COPY --from=pruner /tmp/pruned/json/ ./
COPY --from=pruner /tmp/pruned/package-lock.json ./package-lock.json
RUN --mount=type=cache,target=/root/.npm HUSKY=0 npm ci --omit=dev --ignore-scripts
# TypeORM's CLI peer dependencies are not needed by the compiled app.
RUN rm -rf node_modules/typescript node_modules/ts-node

# npm leaves a dependency nested under its workspace when the hoisted slot
# is already taken by an incompatible version: messenger-bot and
# wispace-client want undici ^7 while discord.js pins ^6, so undici 7 only
# ever exists under apps/<app>/node_modules and packages/<pkg>/node_modules.
# Those nested trees are real runtime dependencies, and the COPY below
# overlays packages/ with the build stage's devDependency install — stash
# them first, restore them after the flatten.
RUN set -eu; \
    for dir in apps/*/ packages/*/; do \
      [ -d "${dir}node_modules" ] || continue; \
      mkdir -p "/nested/${dir}"; \
      cp -a "${dir}node_modules" "/nested/${dir}node_modules"; \
    done

COPY --from=build /app/packages ./packages

# Flatten only the pruned dependency closure and keep runtime artifacts only.
RUN for pkg in packages/*/; do \
      name=$(node -p "require('./${pkg}package.json').name" 2>/dev/null || true); \
      if [ -n "$name" ] && [ -d "node_modules/$name" ]; then \
        rm -rf "node_modules/$name"; \
        mkdir -p "node_modules/$name"; \
        cp "$pkg/package.json" "node_modules/$name/package.json"; \
        cp -r "$pkg/dist" "node_modules/$name/dist"; \
        if [ -d "/nested/${pkg}node_modules" ]; then \
          cp -a "/nested/${pkg}node_modules" "node_modules/$name/node_modules"; \
        fi; \
      fi; \
    done

# The app's own nested dependencies, at the path Node resolves from
# apps/<app>/dist/main.js. The directory is always created so the
# production stage's COPY has a source even for a bot with nothing nested.
RUN set -eu; \
    mkdir -p "apps/${APP_NAME}/node_modules"; \
    if [ -d "/nested/apps/${APP_NAME}/node_modules" ]; then \
      cp -a "/nested/apps/${APP_NAME}/node_modules/." "apps/${APP_NAME}/node_modules/"; \
    fi

FROM node:26.8.1-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS production
WORKDIR /app

# Global ARGs are out of scope after FROM — redeclare per stage that uses them.
ARG APP_NAME
ARG APP_PORT

ENV NODE_ENV=production
ENV APP_NAME=$APP_NAME

# psql: the deploy script holds the migration advisory lock on the same psql
# session that runs the migration (#203) — psql must exist in the runtime image.
RUN apk add --no-cache postgresql-client

RUN addgroup -g 1001 -S app \
  && adduser -S app -u 1001 -G app

COPY --from=build --chown=app:app /app/apps/$APP_NAME/dist ./apps/$APP_NAME/dist
COPY --from=production-deps --chown=app:app /app/node_modules ./node_modules
COPY --from=production-deps --chown=app:app /app/apps/$APP_NAME/node_modules ./apps/$APP_NAME/node_modules

USER app

EXPOSE $APP_PORT

CMD ["sh", "-c", "exec node apps/$APP_NAME/dist/main.js"]
