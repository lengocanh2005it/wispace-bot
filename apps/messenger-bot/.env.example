# Messenger bot — platform-specific config.
# All secrets are loaded from HashiCorp Vault at runtime.
# See apps/messenger-bot/.env.example for the full list of Vault-stored variables.
#
# Shared variables (DB, OpenAI, LLM, Redis, Wispace API) are in Vault at
# secret/data/shared/prd. Messenger-specific secrets are at secret/data/messenger/prd.
# Data-quality checks use the shared `DATA_QUALITY_*` variables; the production
# cron runs at 09:15 ICT and can be disabled with `DATA_QUALITY_CRON_ENABLED=false`.

# HashiCorp Vault — runtime secrets
VAULT_ADDR=https://vault.wispace.app
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Override default path (optional)
# VAULT_SECRET_PATH=secret/data/wispace-bots/messenger/prd

# Cap (chars) for error text persisted in DB columns — last_error/error_message
# (data minimization #640, default 2000). See docs/data-minimization-audit.md.
# PERSISTED_ERROR_MAX_CHARS=2000
