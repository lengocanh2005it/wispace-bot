# Copy to .env for local dev, or use Doppler: docs/doppler-secrets.md
# Platform-specific only. Variables shared across all bots (WISPACE_INTERNAL_KEY,
# OPENAI_*, DB_*, STUDY_REMINDER_TIMEZONE/SYNC_HORIZON/MIN_LEAD...) are in
# root .env.shared.example.
# Messenger / Meta
PAGE_ACCESS_TOKEN=EAABxxxxxxxxxxxxxxxx
VERIFY_TOKEN=wispace_verify_token
# App Secret (Meta App Dashboard → Settings → Basic) — verify POST /webhook
MESSENGER_APP_SECRET=replace-with-meta-app-secret
# true | false — default: true when MESSENGER_APP_SECRET is set; false when unset
MESSENGER_WEBHOOK_SIGNATURE_VERIFY=true
PORT=3000
# Cap JSON/urlencoded body size (webhook + ops APIs)
HTTP_JSON_BODY_LIMIT=256kb
GRAPH_API_VERSION=v21.0
MESSENGER_PAGE_ID=1192471430606671

# OpenAI (reports, reminders, chat agent) — OPENAI_* shared, see .env.shared.example

# WISPACE API — auth: x-psid (Messenger PSID) + X-Internal-Key (server-to-server)
# WISPACE_INTERNAL_KEY, WISPACE_API_VERIFY_TOKEN_URL (shared across 3 bots), WISPACE_API_MAX_RETRIES/
# RETRY_BASE_DELAY_MS, WISPACE_API_TASK_SCORE_URL/USER_GOALS_URL/USER_CALENDAR_URL shared
# across all bots — see .env.shared.example
# Token required — startup fails if VERIFY URL / INTERNAL_KEY missing or mode differs from token
MESSENGER_LINK_MODE=token

# Automatic study reports (cron 08:00)
WISPACE_REPORT_DAYS_BEFORE_EXAM_MIN=2
WISPACE_REPORT_DAYS_BEFORE_EXAM_MAX=3

# Report send outbox retry (R5) — Wispace 5xx / Meta Send API 5xx in report cron
REPORT_SEND_MAX_RETRIES=3
REPORT_SEND_RETRY_BACKOFF_MINUTES=15
REPORT_SEND_RETRY_POLL_MINUTES=15
# Parallel Wispace+OpenAI calls per batch in 08:00 cron (default 5)
REPORT_SEND_CONCURRENCY=5
# Release scheduled_report_claims stuck in 'claimed' after this age (default 2h)
REPORT_CLAIM_STALE_RESET_MS=7200000

# Study session reminders (study_reminder_jobs)
# Adaptive dispatch poll: instead of fixed 1-minute poll, auto-adjusts based on next job
STUDY_REMINDER_POLL_MIN_MS=30000    # fastest poll every 30s
STUDY_REMINDER_POLL_MAX_MS=210000   # slowest poll every 3.5 minutes (when no jobs)
STUDY_REMINDER_POLL_LEAD_MS=60000   # wake up 60s earlier than next job
STUDY_REMINDER_MINUTES_BEFORE=30
# STUDY_REMINDER_MIN_LEAD_MINUTES, STUDY_REMINDER_SYNC_HORIZON_HOURS, STUDY_REMINDER_TIMEZONE
# shared across all bots — see .env.shared.example
STUDY_REMINDER_MAX_RETRIES=3
STUDY_REMINDER_RETRY_BACKOFF_MINUTES=2
STUDY_REMINDER_JOB_RETENTION_DAYS=7
STUDY_REMINDER_EVENING_ROLLOVER_HOUR=23
STUDY_REMINDER_STUCK_PROCESSING_MS=600000  # reset jobs stuck in processing over 10 minutes (default)

# Facebook Send API timeout — prevent hanging when Meta is slow (default 10000 = 10s)
MESSENGER_SEND_API_TIMEOUT_MS=10000

# Free-form Messenger chat (queue, typing, bubble splitting)
CHAT_DEBOUNCE_MS=2000
CHAT_MAX_BUBBLES=4
CHAT_BUBBLE_MAX_CHARS=640

# Max pending messages per user while bot is processing (0 = no cap)
CHAT_MAX_PENDING_MESSAGES=20

# Free-form chat rate limit (FREE_FORM) — Phase 0+; enforcement from Phase 3
# Production/VPS: set true (H1). Local dev can be false.
CHAT_RATE_LIMIT_ENABLED=false
CHAT_FREE_FORM_DAILY_LIMIT=15
CHAT_BURST_PER_MINUTE=3
# CHAT_USAGE_TIMEZONE shared across all bots — see .env.shared.example
# QA PSIDs exempt from limits (comma-separated, optional)
CHAT_RATE_LIMIT_WHITELIST_PSIDS=
# VPS/prod: startup fails if quota disabled, MESSENGER_APP_SECRET missing, or webhook verify disabled
ENFORCE_PROD_CHAT_QUOTA=false
# Show "X remaining" after reply when remaining <= threshold (Phase 6 UX)
CHAT_QUOTA_REMAINING_HINT_THRESHOLD=3
# H2: reserved stuck past TTL (ms) → refund + allow Meta retry with same message.mid (default 600000 = 10 min)
CHAT_IDEMPOTENCY_STUCK_RESERVED_MS=600000
# Daily purge of terminal chat_idempotency rows (completed/refunded, default 90d)
CHAT_IDEMPOTENCY_CLEANUP_ENABLED=true
CHAT_IDEMPOTENCY_RETENTION_DAYS=90
# H5: cap merged text length after debounce before LLM (default 4000)
CHAT_MERGED_TEXT_MAX_CHARS=4000
# H5: does 60s burst count refunded messages (false = don't count, recommended)
CHAT_BURST_COUNT_REFUNDED=false
# R3: burst counter backend — postgres (default) | memory | redis
CHAT_BURST_STORE=postgres
# H6: delete idempotency completed/refunded older than N days (script chat-quota:cleanup)
CHAT_IDEMPOTENCY_RETENTION_DAYS=90
# C2 Q0: dual-write quota audit events (hybrid — keeps messenger_chat_daily_usage)
CHAT_QUOTA_EVENTS_ENABLED=true
CHAT_QUOTA_EVENTS_RETENTION_DAYS=365
# CHAT_QUOTA_EVENTS_CLEANUP_ENABLED — default: follows CHAT_QUOTA_EVENTS_ENABLED
# C2 T0–T2: LLM token usage tracking — LLM_USAGE_ENABLED/TIMEZONE, LLM_COST_USD_PER_1M_*
# shared across all bots, see .env.shared.example
# Global OpenAI concurrency gate (p-limit, in-process — 1 instance)
LLM_EXECUTION_ENABLED=true
LLM_MAX_CONCURRENT=3
# Global concurrency limit across all pods (requires REDIS_ENABLED=true)
LLM_GLOBAL_CONCURRENCY_ENABLED=false
LLM_GLOBAL_MAX_CONCURRENT=10
LLM_OPENAI_RETRY_MAX_ATTEMPTS=3
LLM_OPENAI_RETRY_BACKOFF_MS=2000
LLM_USAGE_RETENTION_DAYS=180
# LLM_USAGE_CLEANUP_ENABLED — default: follows LLM_USAGE_ENABLED
# T3 USD estimate (optional) — API /messenger/ops/llm-usage/* + estimated_cost_usd column
# Multi-LLM provider failover + cooldown — LLM_PROVIDER_FAILOVER_ORDER,
# LLM_FAILOVER_COOLDOWN_LONG_MS, LLM_FAILOVER_COOLDOWN_SHORT_MS,
# LLM_FAILOVER_QUICK_RETRY_DELAY_MS shared across all bots — see .env.shared.example
# CHAT_QUOTA_WINDOW=daily
# H7 legacy: CHAT_QUEUE_SHARED=true → maps CHAT_QUEUE_STORE/CHAT_HISTORY_STORE=redis when not explicitly set
CHAT_QUEUE_SHARED=false
CHAT_QUEUE_PROCESSING_STUCK_MS=300000
# Stale in-process queue eviction (ms) — memory queue only (default 3600000 = 1 hour)
CHAT_QUEUE_STALE_TTL_MS=3600000
# Stale queue entry eviction frequency (ms) — default 900000 = 15 minutes
CHAT_QUEUE_CLEANUP_INTERVAL_MS=900000
CHAT_WEBHOOK_DEDUPE_RETENTION_MS=86400000
# R1: LLM context — memory (default) | redis (postgres table removed)
# redis → requires REDIS_ENABLED=true; key chat:history:{psid}
CHAT_HISTORY_STORE=memory
CHAT_HISTORY_TTL_MS=1800000
CHAT_HISTORY_MAX_MESSAGES=12
# R4: debounce queue backend — memory (default) | redis (postgres table removed)
# redis → chat:queue:buffer:{psid}; CHAT_QUEUE_SHARED=true → redis when not explicitly set
CHAT_QUEUE_STORE=memory

# Durable inbound webhook inbox (webhook_inbound_events): every authenticated
# Messenger/Zalo event is persisted BEFORE the endpoint acknowledges it (200).
# Duplicate deliveries are idempotent (unique platform+event_id); failed
# events are retried by the inbound retry cron with bounded exponential backoff.
WEBHOOK_INBOUND_MAX_RETRIES=5
WEBHOOK_INBOUND_BASE_RETRY_MS=60000
WEBHOOK_INBOUND_CAP_RETRY_MS=480000
WEBHOOK_INBOUND_RETRY_LIMIT=20

# Redis (VPS standalone Docker — folder ~/redis on VPS, not in this repo)
# R0: connection + GET /health/redis | R1–R4: history, dedupe, burst, queue stores
# Local + VPS app share: REDIS_HOST = VPS IP, REDIS_PORT=6379, REDIS_PASSWORD matches redis.conf on VPS
# Cache operations (dedupe, history, tool cache, display name, concurrency) share one connection.
# If Redis server saturates under high load, consider splitting cache into dedicated client.
REDIS_ENABLED=false
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_TLS=false
REDIS_CA=
# R5: display name cache from users table — key cache:user:display:{userId}
USER_DISPLAY_NAME_CACHE_ENABLED=true
USER_DISPLAY_NAME_CACHE_TTL_SECONDS=3600

# LLM safety events — grounding warnings (hallucination detection)
LLM_SAFETY_EVENTS_ENABLED=true
# Alert threshold: ops health reports error if >= N grounding warnings in 24h
LLM_SAFETY_WARNING_DAILY_THRESHOLD=5
# Retention: delete events older than N days (cron 03:00 ICT)
LLM_SAFETY_EVENT_RETENTION_DAYS=30

# Ops health alerts (I1 + S1) — cron 09:00 ICT + scripts ops:health
OPS_HEALTH_ALERT_ENABLED=true
OPS_ALERT_FAILED_JOBS_HOURS=24
OPS_ALERT_STUCK_PROCESSING_MINUTES=10
OPS_ALERT_DENY_LOOKBACK_HOURS=24
OPS_ALERT_MIN_FAILED_JOBS=1
OPS_ALERT_MIN_STUCK_RESERVED=1
OPS_ALERT_MIN_STUCK_PROCESSING=1

# Report cron scale (R4) — multi-pod 08:00 reports.
# false (default): every pod runs cron; the advisory lock serializes the batch.
# true: lease-based leader election (cron_leader_leases) — any pod takes over
# within ~3 min after the current leader dies; identity is INSTANCE_ID/hostname.
CRON_LEADER_ENABLED=false
INSTANCE_ID=

# Webhook dead-letter auto-retry (outbound sends — Discord/Zalo; cron every 5 min)
WEBHOOK_DEAD_LETTER_MAX_RETRIES=5
WEBHOOK_DEAD_LETTER_MIN_RETRY_AGE_MS=60000
WEBHOOK_DEAD_LETTER_RETRY_LIMIT=20

# messenger_message_logs audit retention — cron 03:00 ICT on the 1st of each month
MESSENGER_MESSAGE_LOG_CLEANUP_ENABLED=true
MESSENGER_MESSAGE_LOG_RETENTION_DAYS=90

# Ops HTTP — header X-Internal-Api-Key or Authorization: Bearer
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Doppler runtime sync (prod Docker only) — webhook POST /messenger/ops/doppler-sync
# false on dev; true on prd when Doppler webhook is enabled → VPS
DOPPLER_RUNTIME_SYNC_ENABLED=false
# Read-only service token for prd config (same value as GitHub secret DOPPLER_TOKEN)
DOPPLER_RUNTIME_TOKEN=
DOPPLER_PROJECT=messenger-bot
DOPPLER_CONFIG=prd
DOPPLER_RUNTIME_SYNC_DEBOUNCE_SECONDS=60
# Paths inside container (mounted from host in docker-compose.prod.yml)
DEPLOY_DIR=/deploy
DEPLOY_ENV_FILE=/deploy/.env
DEPLOY_COMPOSE_FILE=/deploy/docker-compose.prod.yml
DEPLOY_CONTAINER_NAME=messenger-bot
# PAT read:packages — container docker login when pulling from GHCR (same as GitHub secret GHCR_PULL_TOKEN)
GHCR_PULL_TOKEN=
GHCR_USER=lengocanh2005it
# VPS deploy user uid/gid — CI sets from id -u / id -g (container can write mounted .env)
DEPLOY_UID=
DEPLOY_GID=
# Host docker.sock group id — CI sets on VPS: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# PostgreSQL — DB_HOST/PORT/NAME/USER/PASSWORD/SSL/LOGGING shared across all bots,
# see .env.shared.example. DB_MIGRATIONS_RUN is messenger-bot specific (runs migration on boot).
DB_MIGRATIONS_RUN=true
# Connection pool — tune for concurrent LLM + quota + cron load (default 10)
DB_POOL_SIZE=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
