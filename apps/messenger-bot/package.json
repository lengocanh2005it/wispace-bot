{
  "name": "@wispace/messenger-bot",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:doppler": "doppler run -- npm run start:dev",
    "env:sync-prod": "gh workflow run sync-env.yml",
    "env:upload-doppler": "node scripts/upload-env-to-doppler.mjs .env",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r tsconfig-paths/register dist/main",
    "db:inspect": "node --env-file=.env scripts/inspect-db.mjs",
    "db:explore-study-schedule": "node --env-file=.env scripts/explore-study-schedule-db.mjs",
    "study-reminder:sync": "npm run build && npm run migration:run && node --env-file=.env scripts/sync-study-reminder-jobs.mjs",
    "study-reminder:sync-only": "npm run build && node --env-file=.env scripts/sync-study-reminder-jobs.mjs --sync-only",
    "study-reminder:jobs": "node --env-file=.env scripts/show-study-reminder-jobs.mjs",
    "ops:health": "node --env-file=.env scripts/ops-daily-health.mjs",
    "messenger:relink": "node --env-file=.env scripts/relink-messenger-mapping.mjs",
    "chat-quota:status": "node --env-file=.env scripts/chat-quota-status.mjs",
    "chat-quota:recover-stuck": "node --env-file=.env scripts/chat-quota-recover-stuck.mjs",
    "chat-quota:cleanup": "node --env-file=.env scripts/chat-quota-cleanup-idempotency.mjs",
    "chat-quota:rebuild": "node --env-file=.env scripts/chat-quota-rebuild.mjs",
    "llm-usage:status": "node --env-file=.env scripts/llm-usage-status.mjs",
    "webhook:dead-letter": "node --env-file=.env scripts/webhook-dead-letter.mjs",
    "migration:run": "npm run build && npx --no-install typeorm migration:run -d dist/infrastructure/database/data-source.js",
    "migration:revert": "npm run build && npx --no-install typeorm migration:revert -d dist/infrastructure/database/data-source.js",
    "migration:show": "npm run build && npx --no-install typeorm migration:show -d dist/infrastructure/database/data-source.js",
    "migration:generate": "npm run build && npx --no-install typeorm migration:generate -d dist/infrastructure/database/data-source.js",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "jest --forceExit --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-pg": "^0.71.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@wispace/bot-common": "*",
    "@wispace/bot-metrics": "*",
    "@wispace/chat-agent": "*",
    "@wispace/chat-history": "*",
    "@wispace/chat-metering": "*",
    "@wispace/chat-queue-core": "*",
    "@wispace/cleanup-cron": "*",
    "@wispace/contracts": "*",
    "@wispace/database": "*",
    "@wispace/llm-agent": "*",
    "@wispace/learner-profile": "*",
    "@wispace/ops-health": "*",
    "@wispace/reschedule-confirm": "*",
    "@wispace/scheduler-core": "*",
    "@wispace/student-report": "*",
    "@wispace/study-reminder-shared": "*",
    "@wispace/wispace-client": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@messenger/(.*)$": "<rootDir>/$1"
    }
  }
}
