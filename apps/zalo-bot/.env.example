# apps/zalo-bot/.env.example
# Copy this to .env for local dev — platform-specific only. Shared variables
# for all bots (WISPACE_INTERNAL_KEY, OPENAI_*, DB_*...) are in root .env.shared.example.
PORT=3002

# Authenticated webhook throttle; Redis shares the window across pods
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_RATE_LIMIT_TTL_MS=60000

# Zalo Official Account — app credentials (developers.zalo.me > Settings >
# "Application secret key"). Zalo has a single app secret key, used both
# for OAuth (/v4/access_token) and webhook signature verification
# (X-ZEvent-Signature) — no separate "OA secret key" exists.
ZALO_APP_ID=replace-with-zalo-app-id
ZALO_APP_SECRET_KEY=replace-with-zalo-app-secret-key

# At-rest encryption key for Zalo OA access/refresh tokens (AES-256-GCM).
# 32 random bytes encoded in base64 (e.g. openssl rand -base64 32). Manage via
# Doppler. Missing/wrong key => token read fails closed (re-bootstrap required).
# ZALO_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Zalo Login OAuth (account-linking) redirect — must match the app's configured redirect URI
ZALO_OAUTH_REDIRECT_URI=https://zalo-bot.example.com/v1/zalo/oauth/callback

ZALO_CHAT_HISTORY_TTL_MS=1800000
ZALO_CHAT_HISTORY_MAX_MESSAGES=20

# Durable inbound webhook inbox — see WEBHOOK_INBOUND_* in messenger-bot .env.example
# (shared table webhook_inbound_events; retry cron runs for both platforms).
WEBHOOK_INBOUND_CLEANUP_ENABLED=true
WEBHOOK_INBOUND_RETENTION_DAYS=30

# Cron expression for OA token auto-refresh (default: every 45 minutes)
# ZALO_TOKEN_REFRESH_CRON=0 */45 * * * *

# Free-form chat rate limit — same config as messenger-bot
CHAT_RATE_LIMIT_ENABLED=false
CHAT_FREE_FORM_DAILY_LIMIT=15
CHAT_BURST_PER_MINUTE=3
CHAT_USAGE_TIMEZONE=Asia/Ho_Chi_Minh

# Max pending messages per user while bot is processing (0 = no cap)
CHAT_MAX_PENDING_MESSAGES=20

# LLM concurrency cap (p-limit, in-process)
LLM_MAX_CONCURRENT=3

# scheduled_report_claims retention cleanup (table shared across all bots; default on, 90 days)
# ZALO_REPORT_CLAIMS_CLEANUP_ENABLED=true
# ZALO_REPORT_CLAIMS_RETENTION_DAYS=90

# Ops HTTP - header X-Internal-Api-Key or Authorization: Bearer (per-bot key, sync with Doppler prd)
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Doppler runtime sync (webhook → sync .env → recreate container) — same as messenger-bot
DOPPLER_RUNTIME_SYNC_ENABLED=false
DOPPLER_PROJECT=zalo-bot
DOPPLER_CONFIG=prd
DOPPLER_RUNTIME_TOKEN=replace-with-doppler-service-token-for-prd
DOPPLER_RUNTIME_SYNC_DEBOUNCE_SECONDS=60

