# Zalo bot — platform-specific config.
# All secrets are loaded from HashiCorp Vault at runtime.
# See apps/zalo-bot/.env.example for the full list of Vault-stored variables.
#
# Shared variables (DB, OpenAI, LLM, Redis, Wispace API) are in Vault at
# secret/data/shared/prd. Zalo-specific secrets are at secret/data/zalo/prd.

# HashiCorp Vault — runtime secrets
VAULT_ADDR=https://vault.wispace.app
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Override default path (optional)
# VAULT_SECRET_PATH=secret/data/wispace-bots/zalo/prd

# Shared learner-facing outbound anti-annoyance cap (#622).
# Production uses Redis for the cross-platform rolling window.
OUTBOUND_RATE_LIMIT_ENABLED=true
OUTBOUND_RATE_LIMIT_MAX_MESSAGES=30
OUTBOUND_RATE_LIMIT_WINDOW_MS=600000

# Per-user write-tool budget (#626) — mutating LLM tools (reschedule, precreate).
# Defaults are generous; normal use never hits them. Only false/0/no disables.
# Note for Zalo: CHAT_RATE_LIMIT_WHITELIST_PSIDS takes Zalo user IDs, not PSIDs.
CHAT_WRITE_TOOL_BUDGET_ENABLED=true
CHAT_WRITE_TOOL_DAILY_CAP_RESCHEDULE=8
CHAT_WRITE_TOOL_DAILY_CAP_PRECREATE=15
CHAT_WRITE_TOOL_PER_MESSAGE_CAP_RESCHEDULE=1
CHAT_WRITE_TOOL_PER_MESSAGE_CAP_PRECREATE=3
CHAT_TOOL_DAILY_USAGE_RETENTION_DAYS=7
