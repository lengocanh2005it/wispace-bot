# apps/zalo-bot/.env.example# Copy this to .env for local dev — platform-specific only. Shared variables# for all bots (WISPACE_INTERNAL_KEY, OPENAI_*, DB_*...) are in root .env.shared.example.PORT=3002# Zalo Official Account — app credentials (developers.zalo.me > Settings ># "Application secret key"). Zalo has a single app secret key, used both# for OAuth (/v4/access_token) and webhook signature verification# (X-ZEvent-Signature) — no separate "OA secret key" exists.ZALO_APP_ID=replace-with-zalo-app-idZALO_APP_SECRET_KEY=replace-with-zalo-app-secret-key# Zalo Login OAuth (account-linking) redirect — must match the app's configured redirect URIZALO_OAUTH_REDIRECT_URI=https://zalo-bot.example.com/v1/zalo/oauth/callbackZALO_CHAT_HISTORY_TTL_MS=1800000ZALO_CHAT_HISTORY_MAX_MESSAGES=20# Webhook dedupe TTL in seconds (default: 60)ZALO_WEBHOOK_DEDUPE_TTL_SECONDS=60# Cron expression for OA token auto-refresh (default: every 45 minutes)# ZALO_TOKEN_REFRESH_CRON=0 */45 * * * *# Free-form chat rate limit — same config as messenger-botCHAT_RATE_LIMIT_ENABLED=falseCHAT_FREE_FORM_DAILY_LIMIT=15CHAT_BURST_PER_MINUTE=3CHAT_USAGE_TIMEZONE=Asia/Ho_Chi_Minh# Max pending messages per user while bot is processing (0 = no cap)CHAT_MAX_PENDING_MESSAGES=20# LLM concurrency cap (p-limit, in-process)LLM_MAX_CONCURRENT=3# Ops HTTP - header X-Internal-Api-Key or Authorization: Bearer (per-bot key, sync with Doppler prd)INTERNAL_API_KEY=replace-with-a-long-random-secret# Doppler runtime sync (webhook → sync .env → recreate container) — same as messenger-botDOPPLER_RUNTIME_SYNC_ENABLED=falseDOPPLER_PROJECT=zalo-botDOPPLER_CONFIG=prdDOPPLER_RUNTIME_TOKEN=replace-with-doppler-service-token-for-prdDOPPLER_RUNTIME_SYNC_DEBOUNCE_SECONDS=60