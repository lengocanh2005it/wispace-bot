# Zalo bot — platform-specific config.
# All secrets are loaded from HashiCorp Vault at runtime.
# See apps/zalo-bot/.env.example for the full list of Vault-stored variables.
#
# Shared variables (DB, OpenAI, LLM, Redis, Wispace API) are in Vault at
# secret/data/wispace-bots/shared/prd. Zalo-specific secrets are at
# secret/data/wispace-bots/zalo/prd.

# HashiCorp Vault — runtime secrets
VAULT_REQUIRED=false
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Non-production Vault profiles may set VAULT_ENV=dev (production is fixed to prd).
# VAULT_ENV=dev

# Platform readiness follows the OA token lifecycle. Keep the existing refresh
# schedule; readiness fails when no usable access token remains.
# ZALO_TOKEN_REFRESH_CRON=0 */45 * * * *

# Account-link recovery and welcome dedupe windows (milliseconds).
ZALO_LINK_RECONCILE_AGE_MS=120000
ZALO_LINK_RECONCILE_MAX_AGE_MS=600000
ZALO_REWELCOME_WINDOW_MS=86400000
ZALO_WELCOME_CLAIM_MS=60000

# Shared learner-facing outbound anti-annoyance cap (#622).
# Production uses Redis for the cross-platform rolling window.
OUTBOUND_RATE_LIMIT_ENABLED=true
OUTBOUND_RATE_LIMIT_MAX_MESSAGES=30
OUTBOUND_RATE_LIMIT_WINDOW_MS=600000

# Per-user write-tool budget (#626) — mutating LLM tools (reschedule, precreate).
# Defaults are generous; normal use never hits them. Only false/0/no disables.
# Note for Zalo: CHAT_RATE_LIMIT_WHITELIST_PSIDS takes Zalo user IDs, not PSIDs.
CHAT_WRITE_TOOL_BUDGET_ENABLED=true
CHAT_WRITE_TOOL_DAILY_CAP_RESCHEDULE=8
CHAT_WRITE_TOOL_DAILY_CAP_PRECREATE=15
CHAT_WRITE_TOOL_PER_MESSAGE_CAP_RESCHEDULE=1
CHAT_WRITE_TOOL_PER_MESSAGE_CAP_PRECREATE=3
CHAT_TOOL_DAILY_USAGE_RETENTION_DAYS=7

# --- Outbound dead-letter replay cron (#291/#711) ---
# The 5-minute cron re-sends failed outbound deliveries from webhook_dead_letters.
# Each row is claimed with an owner lease (lease_token / lease_expires_at) before
# the provider is called so a crashed worker's stale lease is never auto-replayed.
WEBHOOK_DEAD_LETTER_MAX_RETRIES=3
WEBHOOK_DEAD_LETTER_MIN_RETRY_AGE_MS=60000
WEBHOOK_DEAD_LETTER_RETRY_LIMIT=10
WEBHOOK_DEAD_LETTER_LEASE_MS=600000

# --- LLM input classifier tier (#649) — shadow-first, fail-open ---
# Runs a cheap-model classifier on messages that pass the regex gate, flagging
# paraphrased prompt-injection / internal-disclosure probes the regex misses.
LLM_INPUT_CLASSIFIER_ENABLED=false
# When true, a non-SAFE verdict swaps the reply for the canned message.
# No effect unless LLM_INPUT_CLASSIFIER_ENABLED=true. Flip only after the
# shadow-window false-positive review.
LLM_INPUT_CLASSIFIER_ENFORCE=false
# Model id for the classifier (independent of the chat model); required and
# approved as a provider:model pair when the classifier is enabled.
LLM_INPUT_CLASSIFIER_MODEL=google/gemini-2.0-flash-lite
# Maximum redacted learner code points sent to the classifier. Messages over
# this ceiling use a head-and-tail sample with an omission marker. Default 512.
LLM_INPUT_CLASSIFIER_MAX_INPUT_CHARS=512
# Hard per-call deadline in ms. No retry. Timeout => fail open.
LLM_INPUT_CLASSIFIER_TIMEOUT_MS=1200
# Enforce acts only when verdict confidence >= this (0 = act on any non-SAFE).
LLM_INPUT_CLASSIFIER_MIN_CONFIDENCE=0
