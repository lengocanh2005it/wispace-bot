{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": true,
    "assets": ["shared/prompts/**/*"],
    "typeCheck": false,
    "autoCopyAssets": true,
    "swc": {
      "swcrcPath": ".swcrc"
    }
  }
}
