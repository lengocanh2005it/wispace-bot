{
  "name": "@wispace/discord-bot",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r tsconfig-paths/register dist/main",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "jest --forceExit --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@wispace/bot-common": "*",
    "@wispace/bot-metrics": "*",
    "@wispace/chat-agent": "*",
    "@wispace/chat-metering": "*",
    "@wispace/chat-pipeline": "*",
    "@wispace/cleanup-cron": "*",
    "@wispace/contracts": "*",
    "@wispace/database": "*",
    "@wispace/llm-agent": "*",
    "@wispace/learner-profile": "*",
    "@wispace/ops-health": "*",
    "@wispace/reschedule-confirm": "*",
    "@wispace/scheduler-core": "*",
    "@wispace/student-report": "*",
    "@wispace/study-reminder-shared": "^0.0.1",
    "@wispace/wispace-client": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "discord.js": "^14.27.0",
    "helmet": "^8.3.0",
    "necord": "^6.14.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "jest": "^30.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@discord/(.*)$": "<rootDir>/$1"
    }
  }
}
