# Copy this to .env for local dev — platform-specific only. Shared variables# for all bots (WISPACE_INTERNAL_KEY, OPENAI_*, DB_*, STUDY_REMINDER_*...) are in# root .env.shared.example — see docs/doppler-secrets.md.DISCORD_BOT_TOKEN=replace-with-discord-bot-tokenPORT=3001# Discord OAuth2 account-linking (Discord userId <-> WISPACE userId) — see# apps/discord-bot/docs/discord-account-linking.md for the WISPACE-side contractDISCORD_CLIENT_ID=replace-with-discord-application-client-idDISCORD_CLIENT_SECRET=replace-with-discord-application-client-secretDISCORD_OAUTH_REDIRECT_URI=https://discord-bot.example.com/v1/discord/oauth/callback# Frontend page URL that receives the OAuth result (backend redirects here after callback)# Local dev mock FE: http://localhost:4321/callback.htmlDISCORD_OAUTH_FRONTEND_CALLBACK_URL=# Chat rate limit (FREE_FORM quota) — Discord-specific tuning, differs from MessengerCHAT_RATE_LIMIT_ENABLED=falseCHAT_FREE_FORM_DAILY_LIMIT=30CHAT_BURST_PER_MINUTE=5# Max pending messages per user while bot is processing (0 = no cap)CHAT_MAX_PENDING_MESSAGES=20# Max chars for merged user text before sending to the LLMCHAT_MERGED_TEXT_MAX_CHARS=4000# Report cron concurrency (parallel sends per run)DISCORD_REPORT_SEND_CONCURRENCY=3# Guild membership check — set to your Discord server ID to enforce join-before-linkDISCORD_GUILD_ID=DISCORD_INVITE_URL=https://discord.gg/n3Vdb8aJ# LLM concurrency cap (p-limit, in-process)LLM_MAX_CONCURRENT=3# Chat history backend — memory (default) | redis (multi-pod)CHAT_HISTORY_STORE=memoryCHAT_HISTORY_TTL_MS=1800000CHAT_HISTORY_MAX_MESSAGES=20# Redis (optional — for multi-pod chat history)REDIS_ENABLED=falseREDIS_HOST=localhostREDIS_PORT=6379REDIS_PASSWORD=REDIS_TLS=falseREDIS_CA=# Ops HTTP - header X-Internal-Api-Key or Authorization: Bearer (per-bot key, sync with Doppler prd)INTERNAL_API_KEY=replace-with-a-long-random-secret# Doppler runtime sync (webhook → sync .env → recreate container) — same as messenger-botDOPPLER_RUNTIME_SYNC_ENABLED=falseDOPPLER_PROJECT=discord-botDOPPLER_CONFIG=prdDOPPLER_RUNTIME_TOKEN=replace-with-doppler-service-token-for-prdDOPPLER_RUNTIME_SYNC_DEBOUNCE_SECONDS=60