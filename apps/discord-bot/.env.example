# Copy this to .env for local dev — platform-specific only. Shared variables
# for all bots (WISPACE_INTERNAL_KEY, OPENAI_*, DB_*, STUDY_REMINDER_*...) are in
# root .env.shared.example — see docs/doppler-secrets.md.
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
PORT=3001

# Shared HTTP throttle defaults (Redis shares the window across pods)
THROTTLE_DEFAULT_LIMIT=20
THROTTLE_DEFAULT_TTL_MS=60000

# Discord OAuth2 account-linking (Discord userId <-> WISPACE userId) — see
# apps/discord-bot/docs/discord-account-linking.md for the WISPACE-side contract
DISCORD_CLIENT_ID=replace-with-discord-application-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-application-client-secret
DISCORD_OAUTH_REDIRECT_URI=https://discord-bot.example.com/v1/discord/oauth/callback

# Redirect targets after OAuth linking:
# DISCORD_LINK_LANDING_URL — where the user lands after a successful link /
# error / cancel (e.g. the portal root; the portal shows the "Đã liên kết" state itself).
# DISCORD_INVITE_URL — users not yet in the guild are sent straight to the
# server invite; the bot delivers the welcome DM on join (guildMemberAdd).
# The link itself is committed at callback time and does NOT require joining.
DISCORD_LINK_LANDING_URL=
DISCORD_INVITE_URL=https://discord.gg/n3Vdb8aJ

# Chat rate limit (FREE_FORM quota) — Discord-specific tuning, differs from Messenger
CHAT_RATE_LIMIT_ENABLED=false
CHAT_FREE_FORM_DAILY_LIMIT=30
CHAT_BURST_PER_MINUTE=5

# Max pending messages per user while bot is processing (0 = no cap)
CHAT_MAX_PENDING_MESSAGES=20

# Max chars for merged user text before sending to the LLM
CHAT_MERGED_TEXT_MAX_CHARS=4000

# Report cron concurrency (parallel sends per run)
DISCORD_REPORT_SEND_CONCURRENCY=3

# scheduled_report_claims retention cleanup (table shared across all bots; default on, 90 days)
# DISCORD_REPORT_CLAIMS_CLEANUP_ENABLED=true
# DISCORD_REPORT_CLAIMS_RETENTION_DAYS=90

# Guild membership — used by the join-welcome path (DISCORD_WELCOME_CHANNEL_ID)
DISCORD_GUILD_ID=

# LLM concurrency cap (p-limit, in-process)
LLM_MAX_CONCURRENT=3

# Chat history backend — memory (default) | redis (multi-pod)
CHAT_HISTORY_STORE=memory
CHAT_HISTORY_TTL_MS=1800000
CHAT_HISTORY_MAX_MESSAGES=20

# Redis (optional — for multi-pod chat history)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CA=

# Ops HTTP - header X-Internal-Api-Key or Authorization: Bearer (per-bot key, sync with Doppler prd)
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Doppler runtime sync (webhook → sync .env → recreate container) — same as messenger-bot
DOPPLER_RUNTIME_SYNC_ENABLED=false
DOPPLER_PROJECT=discord-bot
DOPPLER_CONFIG=prd
DOPPLER_RUNTIME_TOKEN=replace-with-doppler-service-token-for-prd
DOPPLER_RUNTIME_SYNC_DEBOUNCE_SECONDS=60

