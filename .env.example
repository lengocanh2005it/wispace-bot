# Root .env.example — developer onboarding entry point
#
# This repo is a Turborepo monorepo with 3 bot apps.
# Each app has its own .env.example with platform-specific variables:
#
#   apps/messenger-bot/.env.example  — Meta Messenger (webhook, Send API, chat rate limit)
#   apps/discord-bot/.env.example    — Discord bot token, OAuth2, guild
#   apps/zalo-bot/.env.example       — Zalo OA app/secret, OAuth redirect
#
# Shared variables (Wispace API, OpenAI, PostgreSQL, study reminders):
#   .env.shared.example  — copy to .env.shared at root (do not commit)
#   OPENAI_STALE_OBSERVATION_ROUNDS=2  — age threshold for reducing old tool observations
#
# Production containers bootstrap runtime secrets from HashiCorp Vault.
# See docs/vault-secrets.md for the shared/per-bot paths and AppRole contract.
#
# Quick start:
#   1. cp .env.shared.example .env.shared   (fill in real values)
#   2. cd apps/messenger-bot && cp .env.example .env  (fill in platform tokens)
#   3. npm run start:dev

# Redis operation deadlines (milliseconds). Unset uses the safe defaults;
# explicit values must be integers from 1 through 60000.
# REDIS_COMMAND_TIMEOUT_MS=2000
# REDIS_CONNECT_TIMEOUT_MS=5000

# Host-only Postgres backup contract (#866) — production is rendered from the
# Vault shared path into /home/ngoc_anh/backups/ai_chat_bot_db/backup.env.
# Local development can use these values with ENV_FILE pointing here.
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-secret
OFFSITE_S3_ENDPOINT=https://s3.example.com
OFFSITE_S3_BUCKET=replace-with-versioned-backup-bucket
OFFSITE_S3_ACCESS_KEY=replace-with-least-privilege-access-key
OFFSITE_S3_SECRET_KEY=replace-with-secret-key
# OFFSITE_S3_REGION=us-east-1
